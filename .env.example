# Domain supplied for project setup; confirm institutional policy before public signup.
ALLOWED_EMAIL_DOMAINS=iiti.ac.in
APP_ORIGIN=http://localhost:3000
# Copy the Project URL and publishable key from the intended Supabase environment.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Generate a VAPID key pair for browser push. Keep the private key server-only.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
# Server-only sender credentials. Use a Supabase secret key only on the server.
SUPABASE_SECRET_KEY=
PUSH_DISPATCH_SECRET=
